{
  "useTabs": true,
  "tabWidth": 4,
  "printWidth": 100,
  "singleQuote": true,
  "semi": true,
  "arrowParens": "avoid",
  "trailingComma": "all",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.json", "*.yml", "*.yaml"],
      "options": {
        "useTabs": false,
        "tabWidth": 2
      }
    }
  ]
}
